# Copy to .env before `docker compose up`.
# Never commit .env.

POSTGRES_DB=foodscan
POSTGRES_USER=foodscan
POSTGRES_PASSWORD=foodscan

# Required: unique secret, at least 32 characters
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALLOW_WEAK_SECRET=false

AI_MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SCAN_PER_MINUTE=30
