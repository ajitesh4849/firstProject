# Copy to .env before `docker compose up`.
# Never commit .env.

POSTGRES_DB=foodscan
POSTGRES_USER=foodscan
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Required: unique secret, at least 32 characters. Never use the default in production.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALLOW_WEAK_SECRET=false

# catalog (default) | ai
FOOD_IDENTIFIER=catalog

AI_MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SCAN_PER_MINUTE=30
